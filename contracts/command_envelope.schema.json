{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ventio.local/v0/command-envelope.schema.json",
  "title": "Command Envelope v0 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "commandId", "type", "typeVersion", "tenantId", "companyId", "branchId", "aggregateId", "payload", "clientContext"],
  "properties": {
    "protocolVersion": {"const": 0},
    "commandId": {"type": "string", "format": "uuid"},
    "type": {"type": "string", "pattern": "^[a-z][a-z0-9_.]+$"},
    "typeVersion": {"type": "integer", "minimum": 1},
    "tenantId": {"type": "string", "minLength": 1},
    "companyId": {"type": "string", "minLength": 1},
    "branchId": {"type": "string", "minLength": 1},
    "aggregateId": {"type": "string", "minLength": 1},
    "expectedRevision": {"type": ["integer", "null"], "minimum": 0},
    "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "payload": {"type": "object"},
    "clientContext": {"type": "object", "additionalProperties": false, "required": ["deviceId", "actorId", "moduleVersion", "docTypeVersion"], "properties": {
      "deviceId": {"type": "string", "minLength": 1},
      "actorId": {"type": "string", "minLength": 1},
      "moduleVersion": {"type": "string", "minLength": 5},
      "docTypeVersion": {"type": "integer", "minimum": 1},
      "clientTimestamp": {"type": "string", "format": "date-time"}
    }}
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "extension.operation.execute" } }, "required": ["type"] },
      "then": {
        "properties": {
          "typeVersion": { "const": 1 },
          "expectedRevision": { "type": "integer", "minimum": 1 },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["moduleId", "docType", "operationId", "operationVersion", "inputs"],
            "properties": {
              "moduleId": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
              "docType": { "type": "string", "maxLength": 80, "pattern": "^[A-Z][A-Za-z0-9_]*$" },
              "operationId": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
              "operationVersion": { "type": "integer", "minimum": 1, "maximum": 255 },
              "inputs": { "type": "object", "maxProperties": 32, "propertyNames": { "pattern": "^[a-z][A-Za-z0-9_]{0,79}$" }, "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }
            }
          }
        },
        "required": ["expectedRevision"]
      }
    }
  ]
}
