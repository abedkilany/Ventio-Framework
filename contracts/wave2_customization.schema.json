{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ventio:wave2:customization:1",
  "title": "Governed metadata customization, contract version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "moduleId", "moduleVersion", "docType", "baseSha256", "fields", "properties", "ui"],
  "properties": {
    "contractVersion": {"const": 1},
    "moduleId": {"type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"},
    "moduleVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "docType": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9_]{0,79}$"},
    "baseSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fields": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/field"}},
    "properties": {
      "type": "object", "additionalProperties": false,
      "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 120}, "labelKey": {"type": "string"}},
      "dependentRequired": {"label": ["labelKey"], "labelKey": ["label"]}
    },
    "ui": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "listColumns": {"$ref": "#/$defs/layout"}, "formFields": {"$ref": "#/$defs/layout"}, "detailFields": {"$ref": "#/$defs/layout"},
        "pageTitle": {"type": "string", "minLength": 1, "maxLength": 120}, "pageTitleKey": {"type": "string"},
        "pageIcon": {"enum": ["list", "folder", "article", "location", "business", "tag", "event", "checklist", "grid"]},
        "pageOrder": {"type": "integer", "minimum": 0, "maximum": 10000}
      },
      "dependentRequired": {"pageTitle": ["pageTitleKey"], "pageTitleKey": ["pageTitle"]}
    }
  },
  "$defs": {
    "layout": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][A-Za-z0-9_]{0,79}$"}},
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "required", "label", "labelKey", "readPermission", "writePermission"],
      "properties": {
        "name": {"type": "string", "pattern": "^custom_[A-Za-z0-9_]{1,73}$"},
        "type": {"enum": ["text", "long_text", "integer", "decimal", "boolean", "date", "datetime"]},
        "required": {"const": false}, "label": {"type": "string", "minLength": 1}, "labelKey": {"type": "string"},
        "readPermission": {"type": "string"}, "writePermission": {"type": "string"},
        "maxLength": {"type": "integer", "minimum": 1, "maximum": 65535}, "precision": {"type": "integer", "minimum": 0, "maximum": 9}
      }
    }
  },
  "$comment": "Core additionally enforces namespace, base field compatibility, inherited ACLs, package validation, and a 32 KiB canonical JSON bound. Layouts must reference effective fields; structural custom-field changes require a future migration."
}
