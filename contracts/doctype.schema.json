{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ventio.local/v0/doctype.schema.json",
  "title": "Ventio DocType Definition v0.1 (draft, localization ready)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "moduleId",
    "schemaVersion",
    "kind",
    "fields",
    "permissions",
    "label",
    "labelKey"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "maxLength": 100
    },
    "moduleId": {
      "type": "string",
      "minLength": 3
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "operational",
        "sensitive"
      ]
    },
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seriesId", "field", "prefix", "padding"],
      "properties": {
        "seriesId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "field": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]*$" },
        "prefix": { "type": "string", "pattern": "^[A-Z0-9._/-]{0,24}$" },
        "padding": { "type": "integer", "minimum": 1, "maximum": 12 }
      }
    },
    "businessOperations": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/businessOperation" }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "create",
        "update"
      ],
      "properties": {
        "read": {
          "type": "string",
          "minLength": 3
        },
        "create": {
          "type": "string",
          "minLength": 3
        },
        "update": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listColumns",
        "formFields"
      ],
      "properties": {
        "listColumns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "formFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "labelKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,}$",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "descriptionKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,}$",
      "maxLength": 200
    }
  },
  "$defs": {
    "businessOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "permission", "inputs", "outputs", "effects"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1, "maximum": 255 },
        "permission": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,}$", "maxLength": 200 },
        "inputs": { "$ref": "#/$defs/operationValues" },
        "outputs": { "$ref": "#/$defs/operationValues" },
        "effects": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["document.allocate_number", "document.transition", "record.increment"] } }
      }
    },
    "operationValues": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9_]{0,79}$" },
      "additionalProperties": { "$ref": "#/$defs/operationValue" }
    },
    "operationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "enum": ["text", "integer", "decimal", "boolean", "date", "reference"] },
        "required": { "type": "boolean" },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "precision": { "type": "integer", "minimum": 0, "maximum": 9 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required",
        "label",
        "labelKey"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_]*$"
        },
        "type": {
          "enum": [
            "text",
            "long_text",
            "table",
            "integer",
            "decimal",
            "boolean",
            "date",
            "datetime",
            "reference",
            "enum"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "minLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "minValue": {
          "type": "number"
        },
        "maxValue": {
          "type": "number"
        },
        "precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "default": {
          "type": ["string", "number", "boolean"]
        },
        "readOnly": {
          "type": "boolean",
          "default": false
        },
        "referenceTo": {
          "type": "string"
        },
        "enumValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "labelKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,}$",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "descriptionKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,}$",
          "maxLength": 200
        },
        "enumLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "labelKey"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "labelKey": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){2,}$",
                  "maxLength": 200
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "decimal" } },
            "required": ["type"]
          },
          "then": {},
          "else": { "not": { "required": ["precision"] } }
        },
        {
          "if": {
            "properties": {
              "type": { "enum": ["table", "reference"] }
            },
            "required": ["type"]
          },
          "then": { "not": { "required": ["default"] } }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "integer",
                  "decimal",
                  "boolean",
                  "date",
                  "datetime",
                  "reference",
                  "enum",
                  "table"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["minLength"] },
                { "required": ["maxLength"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "integer"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "minValue": {
                "type": "integer"
              },
              "maxValue": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "text",
                  "long_text",
                  "table",
                  "boolean",
                  "date",
                  "datetime",
                  "reference",
                  "enum"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minValue"
                  ]
                },
                {
                  "required": [
                    "maxValue"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reference"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "referenceTo"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "enumValues",
              "enumLabels"
            ]
          }
        }
      ],
      "dependentRequired": {
        "description": [
          "descriptionKey"
        ],
        "descriptionKey": [
          "description"
        ]
      }
    }
  },
  "dependentRequired": {
    "description": [
      "descriptionKey"
    ],
    "descriptionKey": [
      "description"
    ]
  }
}
